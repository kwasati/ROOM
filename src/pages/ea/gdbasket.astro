import Layout from '../../layouts/Layout.astro';

// content port จาก intensivetrader.com/src/pages/ea/gdbasket.astro (เดิม)
const MAIN = 'https://intensivetrader.com';
const JOURNAL = 'https://journal.intensivetrader.com/';
const DL_LATEST = `${MAIN}/d/gdbasket`; // main button - redirect to the latest file v4.00 (publish/releases/v4.00/gdBasket_v4.00.ex5)
const DL_SET = `${MAIN}/d/gdbasket-veloce26-set`;
const DL_V322 = `${MAIN}/d/gdbasket-v322`;
const DL_V311 = `${MAIN}/d/gdbasket-v311`;
const DL_V310 = `${MAIN}/d/gdbasket-v310`;
const DL_V3092 = `${MAIN}/d/gdbasket-v3092`;
const DL_V202 = `${MAIN}/d/gdbasket-v202`;
const DL_V201 = `${MAIN}/d/gdbasket-v201`;
const DL_V200 = `${MAIN}/d/gdbasket-v200`;
const DL_V137 = `${MAIN}/d/gdbasket-v137`;
const DL_V118 = `${MAIN}/d/gdbasket-v118`;
const XM_AFF = 'https://affs.click/jih0m';
const XM_CODE = 'KWASATI';
const VPS_AFF = 'https://bit.ly/MTCloudVPS';

// Myfxbook — ดึงทุกพอร์ต XS live จาก /api/myfxbook.json ตอน build + fallback ต่อบัญชีกันพัง
// client script ท้ายไฟล์ refresh ค่าสดตอน runtime + clone การ์ดเพิ่มเองเมื่อ API คายพอร์ต XS ใหม่ ไม่ต้องแก้ไฟล์นี้อีก
type MfbCard = {
  id: string; name: string; label: string; url: string | null; newNote: string | null;
  gain: string | null; absGain: string | null; monthly: string | null; drawdown: string | null; balance: string | null;
};
const mfbSlug = (s: string) => (s || 'account').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const mfbFallback: MfbCard[] = [
  { id: '12090186', name: 'gdbasket-xs', label: 'พอร์ต 1', url: 'https://www.myfxbook.com/members/kwasati/gdbasket-xs/12090186', newNote: null, gain: '53.40', absGain: '53.45', monthly: '53.40', drawdown: '18.16', balance: '460.36' },
];
let mfbCards: MfbCard[] = mfbFallback;
try {
  const raw = await fetch('https://www.intensivetrader.com/api/myfxbook.json').then((r) => r.json());
  // API รุ่นเก่าคาย object พอร์ตเดียว (ไม่มี id/name) — แปลงเป็น array โดยถือเป็นพอร์ต 1; รุ่นใหม่คาย array ทุกพอร์ต live
  const accounts = Array.isArray(raw) ? raw : (raw && raw.gain != null ? [{ id: mfbFallback[0].id, name: mfbFallback[0].name, ...raw }] : []);
  const isXs = (a: any) => String(a.id) === mfbFallback[0].id || (a.name || '').toLowerCase().includes('xs');
  const xsAccounts = accounts.filter(isXs); // keep only XS accounts — LX / any other gdBasket* port gets no card
  if (xsAccounts.length > 0) {
    const f = (n: unknown) => (n == null ? null : Number(n).toFixed(2));
    const toCard = (acc: any, base: MfbCard): MfbCard => ({
      ...base,
      id: String(acc.id),
      name: acc.name || base.name,
      url: `https://www.myfxbook.com/members/kwasati/${mfbSlug(acc.name || base.name)}/${acc.id}`,
      newNote: null,
      gain: f(acc.gain), absGain: f(acc.absGain), monthly: f(acc.monthly), drawdown: f(acc.drawdown), balance: f(acc.balance),
    });
    const used = new Set<string>();
    mfbCards = mfbFallback.map((fb) => {
      const acc = xsAccounts.find((a: any) => String(a.id) === fb.id || (a.name || '').toLowerCase() === fb.name.toLowerCase());
      if (!acc) return fb; // fallback ต่อบัญชี — API ยังไม่คืนพอร์ตนี้
      used.add(String(acc.id));
      return toCard(acc, fb);
    });
    // XS port that is not known yet — append as an extra card
    for (const acc of xsAccounts) {
      if (!used.has(String(acc.id))) mfbCards.push(toCard(acc, { id: '', name: '', label: `พอร์ต ${mfbCards.length + 1}`, url: null, newNote: null, gain: null, absGain: null, monthly: null, drawdown: null, balance: null }));
    }
  }
} catch (e) { /* ใช้ fallback */ }

const features = [
  { title: 'อ่านตลาด 3 ชั้น', desc: 'ก่อนเปิดตะกร้า ระบบวัด 3 อย่างจากแท่งที่ปิดล่าสุด: ตลาดผันผวนแค่ไหน (Gear) · ร้อนกว่าปกติแค่ไหน (Market Temp) · ราคาอยู่โซนไหน (House)', tag: 'Gear · Market Temp · House' },
  { title: '28 ชุดค่า ล็อกต่อตะกร้า', desc: '2 เกียร์ × 7 ช่วงความร้อน × 2 บ้าน = 28 ชุดค่า (ขนาดไม้ · ระยะกริด · TP) ตะกร้าเปิดด้วยชุดไหน ใช้ชุดนั้นจนปิด ไม่เปลี่ยนกลางทาง', tag: 'ล็อกชุดค่าตั้งแต่ไม้แรก' },
  { title: 'ข้ามตลาดที่ไม่คุ้ม', desc: 'ตลาดร้อนเกิน หรือราคาอยู่โซนกลางระหว่างเส้นบ้าน — ระบบไม่เปิดตะกร้า รอจังหวะถัดไป', tag: 'ไม่เปิดเมื่อไม่คุ้ม' },
];

const engineSteps = [
  { label: 'Gear', title: 'ความผันผวน', desc: 'วัด ATR14 (M15) เป็นจุด · ต่ำกว่า 300 จุด = เกียร์ต่ำ (ตลาดเงียบ ใช้ชุดที่จูนจากยุคตลาดนิ่ง) · ตั้งแต่ 300 จุด = เกียร์สูง (ตลาดวิ่งแรง ใช้ชุดที่จูนจากยุคทองผันผวน)' },
  { label: 'Market Temp', title: 'ความร้อนของตลาด', desc: 'เทียบ ATR ตอนนี้กับค่าเฉลี่ย 5 วัน แบ่ง 7 ช่วงความร้อน · ร้อนเกิน = ข้าม' },
  { label: 'House', title: 'โซนราคา', desc: 'ราคาเหนือเส้นบ้านบน = บ้านบน (ซื้อตามเทรนด์) · ต่ำกว่าเส้นบ้านล่าง = บ้านล่าง (ซื้อตอนย่อ) · อยู่ระหว่างเส้น = ข้าม' },
  { label: 'ชุดค่า', title: '', desc: 'ได้ 1 ใน 28 ชุด แล้วล็อกกับตะกร้านั้น · ชุดค่าถูกเก็บไว้ในไม้แรกที่โบรก ปิด / เปิด MT5 กลางรอบก็ใช้ชุดเดิมต่อ' },
];

const howSteps = [
  '<strong class="text-gray-light">เช็กตลาด</strong> — ทุกต้นชั่วโมงระบบอ่าน Gear · Market Temp · House ถ้าเข้าเงื่อนไขข้าม = ยังไม่เปิด',
  '<strong class="text-gray-light">เลือกชุดค่า</strong> — หยิบชุดที่ตรงกับตลาดตอนนั้น แล้วล็อกกับตะกร้า',
  '<strong class="text-gray-light">ราคาลง ระบบทยอยซื้อ</strong> — วางไม้ตามระยะกริดของชุดนั้น และจำกัดไม้ต่อแท่งไม่ให้รัวตอนราคาดิ่ง (Drip)',
  '<strong class="text-gray-light">ราคาขึ้น ระบบเติมกำไร</strong> — PPTS เติมไม้ตามทางพร้อมไล่ล็อกกำไร',
  '<strong class="text-gray-light">ปิดทั้งชุด</strong> — ทุกไม้ปิดพร้อมกันที่ TP เดียวของตะกร้า · ตะกร้าค้างนานเกิน 75 นาที ระบบลดเป้ากำไรลง (กฎเท่าทุน) เพื่อออกให้ไว',
