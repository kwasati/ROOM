---
import Layout from '../layouts/Layout.astro';
import BrokerCTA from '../components/BrokerCTA.astro';
import { getCollection, render } from 'astro:content';
import { eaItems } from '../data/ea';
import { toolItems } from '../data/tools';

const courses = (await getCollection('courses')).sort((a, b) => a.data.order - b.data.order);
const allLessons = (await getCollection('lessons')).sort((a, b) => a.data.order - b.data.order);

const lessonCounts = new Map<string, number>();
for (const lesson of allLessons) {
  lessonCounts.set(lesson.data.course, (lessonCounts.get(lesson.data.course) || 0) + 1);
}

// Pre-render lesson content (inline toggle for courses)
const renderedLessons = new Map<string, { id: string; title: string; duration?: string; order: number; course: string; Content: any }[]>();
for (const lesson of allLessons) {
  const { Content } = await render(lesson);
  const courseId = lesson.data.course;
  if (!renderedLessons.has(courseId)) renderedLessons.set(courseId, []);
  renderedLessons.get(courseId)!.push({
    id: lesson.id.split('/').pop()!,
    title: lesson.data.title,
    duration: lesson.data.duration,
    order: lesson.data.order,
    course: courseId,
    Content,
  });
}

// Normalize courses -> unified card shape
const courseItems = courses.map(c => ({
  kind: 'course' as const,
  id: c.id,
  title: c.data.title,
  description: c.data.description,
  count: lessonCounts.get(c.id) || 0,
  isLearn: c.data.courseType === 'learn',
  cardType: c.data.courseType, // 'learn' | 'learn-tool'
  pinned: c.data.pinned ?? false,
  pinOrder: c.data.pinOrder,
}));

type Item = (typeof eaItems)[number] | (typeof toolItems)[number] | (typeof courseItems)[number];
const allItems: Item[] = [...eaItems, ...toolItems, ...courseItems];

// single grid: pinned first (pin order), then the rest in list order
const pinnedItems = allItems
  .filter(i => i.pinned)
  .sort((a, b) => (a.pinOrder ?? 999) - (b.pinOrder ?? 999));
const gridItems = [...pinnedItems, ...allItems.filter(i => !i.pinned)];

const itemKey = (i: Item) => `${i.kind}:${i.id}`;

// filter pills — a category with 0 items renders dimmed ("เร็ว ๆ นี้")
const learnCount = allItems.filter(i => i.cardType === 'learn' || i.cardType === 'learn-tool').length;
const eaCount = allItems.filter(i => i.cardType === 'ea').length;
const toolCount = allItems.filter(i => i.cardType === 'tool').length;
const pills = [
  { filter: 'all', label: 'ทั้งหมด', count: allItems.length },
  { filter: 'learn', label: 'บทเรียน', count: learnCount },
  { filter: 'ea', label: 'EA', count: eaCount },
  { filter: 'tool', label: 'เครื่องมือ', count: toolCount },
];
---

<Layout title="Room — เรียน+เทรดฟรี | IntensiveTrader">
  <div id="main-content" class="room-index">

    <!-- HEADER -->
    <section class="hub-hero">
      <div class="hub-orb hub-orb-a" aria-hidden="true"></div>
      <div class="hub-orb hub-orb-b" aria-hidden="true"></div>
      <div class="max-w-[1100px] mx-auto px-5 relative">
        <h1 class="pixel text-[22px] max-md:text-[18px] text-gray-light leading-normal mb-3">ROOM</h1>
        <p class="text-[15px] text-gray max-w-[600px] leading-relaxed">
          แหล่งรวมของที่ผมทำขึ้นมาใช้เอง — บทเรียน · EA · เครื่องมือ · ใช้ล็อกอินเดียวกับ intensivetrader.com
        </p>
        <div class="filter-pills hub-pills" id="course-filter" role="group" aria-label="กรองรายการ">
          {pills.map(p => (
            <button data-filter={p.filter} class={`filter-btn${p.filter === 'all' ? ' active' : ''}${p.count === 0 ? ' dim' : ''}`} aria-pressed={p.filter === 'all' ? 'true' : 'false'}>
              {p.label}<span>{p.count === 0 ? 'เร็ว ๆ นี้' : p.count}</span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- CATALOG -->
    <section class="room-catalog max-w-[1100px] mx-auto px-5 pt-8 pb-4" aria-label="รายการเนื้อหาใน Room">
      <div id="item-grid" class="hub-grid">
        {gridItems.map((item, idx) => (
          <div data-course-type={item.cardType} data-item-key={itemKey(item)} data-idx={idx}>
            {item.kind === 'ea' ? (
              <a href={item.href} class="hub-card">
                <div class="hub-tags">
                  <span class="hub-tag ea">EA · MT5</span>
                  {item.live && <span class="hub-tag live">● LIVE{item.version ? ` ${item.version}` : ''}</span>}
                  <span class="hub-tag">ฟรี</span>
                </div>
                <h3 class="pixel">{item.title}</h3>
                <p>{item.description}</p>
                <div class="hub-foot"><span>room / ea / {item.id}</span><span class="go">ดู + โหลด →</span></div>
              </a>
            ) : item.kind === 'tool' ? (
              <a href={item.href} class="hub-card" target="_blank" rel="noopener">
                <div class="hub-tags">
                  {item.badges.map((b, i) => <span class={`hub-tag${i === 0 ? ' tool' : ''}`}>{b}</span>)}
                </div>
                <h3 class="pixel">{item.title}</h3>
                <p>{item.description}</p>
                <div class="hub-foot"><span>{item.footerText}</span><span class="go">{item.actionText}</span></div>
              </a>
            ) : (
              <button type="button" data-course-id={item.id} class="hub-card" aria-expanded="false">
                <div class="hub-tags">
                  <span class="hub-tag learn">บทเรียน</span>
                  <span class="hub-tag">ฟรี</span>
                </div>
                <h3 class="pixel">{item.title}</h3>
                <p>{item.description}</p>
                <div class="hub-foot"><span>{item.count} บท</span><span class="go">ดูบทเรียน</span></div>
              </button>
            )}
          </div>
        ))}
      </div>

      <!-- Inline course content (toggle on hub-card click) -->
      {courses.map(course => {
        const courseLessons = renderedLessons.get(course.id) || [];
        const isMultiLesson = courseLessons.length > 1;
        return (
          <div id={`content-${course.id}`} class="course-preview hidden" data-course-content={course.id}>
            <div class="course-preview-head">
              <div>
                <span>COURSE OUTLINE</span>
                <h2>{course.data.title}</h2>
              </div>
              <button class="close-content" aria-label="ปิด">
                <svg class="w-[19px] h-[19px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
              </button>
            </div>

            {isMultiLesson && (
              <div class="lesson-tabs" data-course-tabs={course.id}>
                {courseLessons.map((lesson, i) => (
                  <button data-lesson-tab={`${course.id}/${lesson.id}`} class={`lesson-tab ${i === 0 ? 'active' : ''}`}>
                    <span>{String(i + 1).padStart(2, '0')}</span>{lesson.title}
                  </button>
                ))}
              </div>
            )}

            {courseLessons.map((lesson, i) => (
              <div data-lesson-content={`${course.id}/${lesson.id}`} class={`lesson-preview-copy ${i > 0 ? 'hidden' : ''}`}>
                {isMultiLesson && <div class="lesson-index">บทที่ {i + 1} / {courseLessons.length}</div>}
                {lesson.duration && <p class="text-[13px] text-gray-dark mb-4">{lesson.duration}</p>}
                <article class="prose prose-invert max-w-none
                  prose-headings:font-bold prose-headings:text-gray-light
                  prose-p:text-gray prose-p:leading-relaxed
                  prose-a:text-primary prose-a:no-underline hover:prose-a:underline
                  prose-strong:text-gray-light
                  prose-code:text-primary-light prose-code:bg-dark prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
                  prose-li:text-gray prose-ol:text-gray prose-ul:text-gray
                  prose-table:text-gray prose-th:text-gray-light prose-td:border-dark-border prose-th:border-dark-border">
                  <lesson.Content />
                </article>
              </div>
            ))}

            <BrokerCTA placement="end-of-lesson" />
          </div>
        );
      })}

      <div id="catalog-empty" class="catalog-empty hidden">ยังไม่มีในหมวดนี้ — กำลังทำอยู่</div>

    </section>

  </div>
</Layout>

<style>
  .hub-hero { position: relative; overflow: hidden; padding: 64px 0 28px; background: var(--color-dark); border-bottom: 1px solid var(--color-dark-border); }
  .hub-hero::before { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: .18; background-image: radial-gradient(var(--color-primary) 1px, transparent 1px); background-size: 20px 20px; }
  .hub-orb { position: absolute; border-radius: 50%; pointer-events: none; filter: blur(70px); background: rgba(220, 38, 38, .18); }
  .hub-orb-a { width: 380px; height: 380px; top: -60px; left: 15%; }
  .hub-orb-b { width: 300px; height: 300px; bottom: -120px; right: 10%; background: rgba(220, 38, 38, .1); }
  .hub-pills { margin-top: 28px; }
  .filter-pills button.dim { opacity: .45; }
  .filter-pills button.dim.active { opacity: 1; }
  .filter-pills button span { white-space: nowrap; }
  .hub-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 18px; }
  .hub-grid > div { display: flex; }
  .hub-card { width: 100%; display: flex; flex-direction: column; gap: 12px; padding: 22px; text-align: left; color: var(--color-gray-light); background: var(--color-dark-card); border: 1px solid var(--color-dark-border); border-radius: 12px; cursor: pointer; transition: transform 160ms ease-out, border-color 160ms ease-out; }
  .hub-card:hover { transform: translateY(-2px); border-color: var(--color-primary); }
  .hub-card.expanded { border-color: var(--color-primary); }
  .hub-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .hub-tag { padding: 2px 8px; color: var(--color-gray); background: #262626; border-radius: 4px; font-size: 11px; font-weight: 600; }
  .hub-tag.ea { color: #f87171; background: #2a1010; }
  .hub-tag.live { color: var(--color-green); background: #0f2a18; }
  .hub-tag.tool { color: var(--color-secondary); background: #2a2005; }
  .hub-tag.learn { color: var(--color-primary-light); background: rgba(220, 38, 38, .1); }
  .hub-card h3 { margin: 0; color: var(--color-gray-light); font-size: 14px; line-height: 1.6; }
  .hub-card p { flex: 1; margin: 0; color: var(--color-gray); font-size: 14px; line-height: 1.6; }
  .hub-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 12px; color: var(--color-gray-dark); font-size: 13px; }
  .hub-foot .go { color: var(--color-primary); font-weight: 600; white-space: nowrap; }
  @media (max-width: 767px) {
    .hub-hero { padding: 46px 0 22px; }
    .hub-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Course card toggle (course cards only — EA / tool cards are <a> links)
  const courseCards = document.querySelectorAll<HTMLButtonElement>('button.hub-card');
  const courseContents = document.querySelectorAll<HTMLElement>('.course-preview');
  let activeCourse: string | null = null;

  function setCardExpanded(courseId: string, expanded: boolean) {
    document.querySelectorAll<HTMLButtonElement>(`button.hub-card[data-course-id="${courseId}"]`).forEach(card => {
      card.classList.toggle('expanded', expanded);
      card.setAttribute('aria-expanded', String(expanded));
      const meta = card.querySelector('.hub-foot span:last-child');
      if (meta) meta.textContent = expanded ? 'กำลังเปิด' : 'ดูบทเรียน';
    });
  }

  courseCards.forEach(card => {
    card.addEventListener('click', () => {
      const courseId = card.getAttribute('data-course-id')!;
      if (activeCourse === courseId) {
        document.getElementById(`content-${courseId}`)?.classList.add('hidden');
        setCardExpanded(courseId, false);
        activeCourse = null;
        return;
      }
      courseContents.forEach(c => c.classList.add('hidden'));
      if (activeCourse) setCardExpanded(activeCourse, false);
      const content = document.getElementById(`content-${courseId}`);
      if (content) {
        content.classList.remove('hidden');
        setCardExpanded(courseId, true);
        activeCourse = courseId;
        setTimeout(() => content.scrollIntoView({ behavior: 'smooth', block: 'start' }), 50);
      }
    });
  });

  document.querySelectorAll('.close-content').forEach(btn => {
    btn.addEventListener('click', () => {
      const content = btn.closest('.course-preview') as HTMLElement;
      if (content) {
        content.classList.add('hidden');
        const courseId = content.getAttribute('data-course-content')!;
        setCardExpanded(courseId, false);
        activeCourse = null;
      }
    });
  });

  // Lesson tabs
  document.querySelectorAll<HTMLButtonElement>('.lesson-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const lessonKey = tab.getAttribute('data-lesson-tab')!;
      const courseId = lessonKey.split('/')[0];
      document.querySelectorAll<HTMLButtonElement>(`[data-lesson-tab^="${courseId}/"]`).forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      document.querySelectorAll<HTMLElement>(`[data-lesson-content^="${courseId}/"]`).forEach(body => body.classList.add('hidden'));
      document.querySelector<HTMLElement>(`[data-lesson-content="${lessonKey}"]`)?.classList.remove('hidden');
    });
  });

  // Filter
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const filterCards = document.querySelectorAll<HTMLElement>('[data-course-type]');
  const catalogEmpty = document.getElementById('catalog-empty');

  function applyFilter(filter: string) {
    filterBtns.forEach(b => {
      const on = b.getAttribute('data-filter') === filter;
      b.classList.toggle('active', on);
      b.setAttribute('aria-pressed', String(on));
    });
    let visibleCount = 0;
    filterCards.forEach(card => {
      const type = card.getAttribute('data-course-type');
      const match = filter === 'all' || type === filter || (filter === 'learn' && type === 'learn-tool');
      (card as HTMLElement).style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });
    catalogEmpty?.classList.toggle('hidden', visibleCount > 0);
    // hide inline content while filtering
    courseContents.forEach(c => c.classList.add('hidden'));
    if (activeCourse) setCardExpanded(activeCourse, false);
    activeCourse = null;
  }

  filterBtns.forEach(btn => btn.addEventListener('click', () => applyFilter(btn.getAttribute('data-filter') || 'all')));

  // ?filter=ea / ?filter=tool -> auto-activate that filter (nav links)
  const urlFilter = new URLSearchParams(window.location.search).get('filter');
  if (urlFilter === 'ea' || urlFilter === 'learn' || urlFilter === 'tool') applyFilter(urlFilter);

  // ── ปักหมุดจาก admin: ดึง content_pins (site_settings) มาเรียงใหม่ใน grid เดียว ──
  // pinned มาก่อน (ตามลำดับ pin) แล้วที่เหลือตามลำดับเดิม · fetch fail / ไม่มี pins = คงลำดับ SSR
  function applyPins(pins: { key: string; order?: number }[]) {
    const grid = document.getElementById('item-grid');
    if (!grid) return;
    const orderMap = new Map(pins.map(p => [p.key, p.order ?? 999]));
    const wrappers = [...grid.querySelectorAll<HTMLElement>('[data-item-key]')];
    const pinned = wrappers
      .filter(w => orderMap.has(w.dataset.itemKey!))
      .sort((a, b) => orderMap.get(a.dataset.itemKey!)! - orderMap.get(b.dataset.itemKey!)!);
    const rest = wrappers
      .filter(w => !orderMap.has(w.dataset.itemKey!))
      .sort((a, b) => Number(a.dataset.idx) - Number(b.dataset.idx));
    [...pinned, ...rest].forEach(w => grid.appendChild(w));
  }

  const SUPA_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPA_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  if (SUPA_URL && SUPA_KEY) {
    (async () => {
      try {
        const res = await fetch(`${SUPA_URL}/rest/v1/site_settings?key=eq.content_pins&select=value`, {
          headers: { apikey: SUPA_KEY },
        });
        if (!res.ok) return;
        const rows = await res.json();
        const pins = rows?.[0]?.value; // JSONB -> array [{key, order}]
        if (Array.isArray(pins) && pins.length) applyPins(pins);
      } catch (e) { /* keep SSR frontmatter default */ }
    })();
  }
</script>
